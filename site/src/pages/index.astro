---
import '../styles/global.css';
import { cta, demo, faq, footer, fullView, hero, heroDesk, how, measured, meta, mockGroups, nav, privacy, real, story, zigzag } from '../content';
import MacDesktop from '../components/MacDesktop.astro';
import FullView from '../components/FullView.astro';
import Mark from '../components/Mark.astro';
import { DOWNLOAD, GITHUB, RELEASES, latestVersion } from '../site';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';

const version = await latestVersion();
// The script's address carries a hash of its contents, so a browser holding an older copy (it may
// cache it for hours) fetches the new one as soon as a deploy changes it.
const scriptVersion = createHash('sha256').update(readFileSync('public/scripts/site.js')).digest('hex').slice(0, 10);
const openCount = mockGroups.flatMap((g) => g.items).filter((i) => !i.startsDone).length;
const downloadIcon = '<path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path>';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{meta.title}</title>
  <meta name="description" content={meta.description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="canonical" href="https://didja.dev/" />
  <meta name="theme-color" content="#FAFAF7" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://didja.dev/" />
  <meta property="og:title" content={meta.title} />
  <meta property="og:description" content={meta.description} />
  <meta property="og:image" content="https://didja.dev/og.png" />
  <meta name="twitter:card" content="summary_large_image" />
</head>
<body>
  <header class="top">
    <nav aria-label="Main" class="wrap nav">
      <a href="#top" class="brand">
        <Mark size={32} />
        <span class="word">didja</span>
      </a>
      <div class="links">
        <a href="#how">{nav.how}</a>
        <a href="#privacy">{nav.privacy}</a>
        <a href={GITHUB}>{nav.github}</a>
        <a href="#download" class="pill-dark">{nav.download}</a>
      </div>
    </nav>
  </header>

  <main>
    <!-- HERO -->
    <section id="top" class="wrap hero">
      <div class="hero-copy">
        <p class="tag">{hero.tag}</p>
        <h1>{hero.titleBefore} <span class="marker swipe">{hero.titleMark}</span></h1>
        <p class="hero-sub">{hero.lead}</p>
        <p class="hero-bold">{hero.bold}</p>
        <div class="row">
          <a href="#download" class="btn btn-dark">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={downloadIcon}></svg>
            {hero.download}
          </a>
          <a href={GITHUB} class="btn btn-line">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"></path></svg>
            {hero.star}
          </a>
        </div>
        <p class="fine">{hero.meta}</p>
      </div>

      <!-- Hero app mock: click an item to tick it -->
      <div class="hero-mock">
        <svg class="stroke" viewBox="0 0 600 700" preserveAspectRatio="none" aria-hidden="true">
          <path data-draw d="M -40 120 C 120 40, 260 210, 330 150 S 560 30, 610 160 S 420 420, 300 380 S 40 330, 90 520 S 420 700, 640 640"></path>
        </svg>
        <div class="mock" data-mock>
          <!-- The Mac's menu bar, with Didja's icon pressed -->
          <div class="menubar">
            <svg class="mb-apple" aria-hidden="true" width="12" height="14" viewBox="0 0 17 20" fill="currentColor"><path d="M14.1 10.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.8 1.2 1.8 2.6 3.1 2.5 1.3-.1 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.6-1-2.6-4.2ZM11.6 3c.7-.8 1.2-2 1-3.1-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.4Z"/></svg>
            <strong class="mb-app">{heroDesk.app}</strong>
            {heroDesk.menus.map((m) => <span class="mb-menu">{m}</span>)}
            <span class="mb-right">
              <svg aria-hidden="true" width="16" height="12" viewBox="0 0 24 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M2 6.5a15 15 0 0 1 20 0M5.5 10a10 10 0 0 1 13 0M9 13.5a5 5 0 0 1 6 0"/><circle cx="12" cy="16.5" r=".8" fill="currentColor"/></svg>
              <svg aria-hidden="true" width="22" height="11" viewBox="0 0 26 13" fill="none" stroke="currentColor" stroke-width="1.4"><rect x=".7" y=".7" width="21" height="11.6" rx="3"/><rect x="2.6" y="2.6" width="13" height="7.8" rx="1.6" fill="currentColor" stroke="none"/><path d="M24 4.5v4" stroke-linecap="round"/></svg>
              <span class="menubar-item"><Mark size={15} stroke={8} /><span data-count>{openCount}</span></span>
              <span>{hero.mockClock}</span>
            </span>
          </div>

          <!-- Behind the popover: the Terminal where the migration ran -->
          <div class="term" aria-hidden="true">
            <div class="term-bar"><i></i><i></i><i></i><span>api-server — zsh</span></div>
            {heroDesk.terminal.map((line) => <div class="term-line">{line}</div>)}
          </div>

          <!-- Didja's popover, hanging from its icon -->
          <div class="panel">
            <div class="panel-head">
              <span class="panel-brand"><Mark size={20} stroke={8} /><span class="panel-title">{hero.mockTitle}</span>
                <span class="panel-pill"><span data-count>{openCount}</span> {hero.mockLeft}</span></span>
              <span class="panel-tools" aria-hidden="true">
                <span class="tool-plus">+</span>
                <span class="tool-full"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7"/></svg>{heroDesk.fullView}</span>
                <span class="tool-more">···</span>
              </span>
            </div>
            <div class="panel-search" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
              {hero.mockSearch}<kbd>F</kbd>
            </div>
            <div class="panel-list">
              {mockGroups.map((group) => {
                const done = group.items.filter((i) => i.startsDone).length;
                return (
                  <div class="group" data-group>
                    <div class="group-source"><span class="dot"></span>{group.source}</div>
                    {group.title && (
                      <div class="group-head">
                        <svg class="pie" aria-hidden="true" width="15" height="15" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8.2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M10 10V1.8A8.2 8.2 0 0 1 18.2 10Z" fill="currentColor"/><path d="M10 10h8.2A8.2 8.2 0 0 1 10 18.2Z" fill="currentColor" data-pie-more/></svg>
                        <span class="group-title">{group.title}</span>
                        <span class="group-count"><span data-group-done>{done}</span>/{group.items.length} · {group.time}</span>
                      </div>
                    )}
                    {group.items.map((item) => (
                      <div class={`qrow${group.title ? ' qstep' : ''}`}>
                        <button type="button" class={`item kind-${item.kind}`} data-item={item.id} data-open={item.open} data-done={item.done}
                                data-auto={item.auto ? '' : undefined} aria-pressed={item.startsDone ? 'true' : 'false'}>
                          <span aria-hidden="true" class="box">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10"></path></svg>
                          </span>
                          <span class="item-text">
                            <span class="item-title">{item.title}</span>
                            <span class="item-meta">{item.startsDone ? item.done : item.open}</span>
                          </span>
                        </button>
                        {item.asks && (
                          <div class="confirm" data-confirm>
                            <span><strong>{hero.confirmLead}</strong> {hero.confirmBody}</span>
                            <span class="confirm-actions">
                              <button type="button" class="yes" data-yes>{hero.confirmYes}</button>
                              <button type="button" class="no" data-no>{hero.confirmNo}</button>
                            </span>
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                );
              })}
              <div class="recent" aria-hidden="true"><span class="chev">›</span>{heroDesk.recently}<span>{heroDesk.recentlyCount}</span></div>
            </div>
            <div class="panel-foot" aria-hidden="true"><span class="live"></span>{hero.mockFooter}<kbd>{hero.mockKeys}</kbd><span class="pause">{heroDesk.pause}</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- THE ZIGZAG -->
    <section aria-labelledby="zigzag-h" class="band">
      <div class="wrap stack-48 pad-96">
        <div class="intro">
          <p class="eyebrow">{zigzag.eyebrow}</p>
          <h2 id="zigzag-h" class="h2" data-light>{zigzag.title}</h2>
          <p class="lead">{zigzag.lead}</p>
        </div>
        <ol class="steps">
          {zigzag.steps.map((step, i) => (
            <li class={i === zigzag.steps.length - 1 ? 'step step-hot' : 'step'} data-reveal>
              <span class="step-n">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how" aria-labelledby="how-h" class="wrap pad-104 stack-56">
      <div class="intro">
        <p class="eyebrow">{how.eyebrow}</p>
        <h2 id="how-h" class="h2" data-light>{how.title}</h2>
        <p class="lead">{how.lead}</p>
      </div>
      <div class="how">
        {how.steps.map((step, i) => (
          <article class="how-step" data-reveal>
            <MacDesktop still scene={[0, 1, 3][i]} label={step.shotLabel.replace('Placeholder for a screenshot', 'Illustration')} />
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </article>
        ))}
      </div>
      <div class="apps">
        <span class="apps-lead">{how.appsLead}</span>
        {how.apps.map((app) => <span class="chip">{app}</span>)}
      </div>
    </section>

    <!-- FULL VIEW: the big window, drawn in the real one's shape -->
    <section id="full-view" aria-labelledby="fv-h" class="wrap pad-104 stack-32 fullview">
      <div class="intro center" data-reveal>
        <p class="eyebrow">{fullView.eyebrow}</p>
        <h2 id="fv-h" class="h2" data-light>{fullView.title}</h2>
        <p class="lead">{fullView.lead}</p>
      </div>
      <div class="fullview-frame" data-reveal><FullView /></div>
    </section>

    <!-- SEE IT: the Mac plays the story by itself once it is in view -->
    <section id="demo" aria-labelledby="demo-h" class="band">
      <div class="wrap pad-104-top">
        <div class="intro center demo-intro">
          <p class="eyebrow">{demo.eyebrow}</p>
          <h2 id="demo-h" class="h2" data-light>{demo.title}</h2>
        </div>
      </div>
      <div class="story" data-story>
        <div class="story-sticky wrap">
          <div class="story-stage"><MacDesktop /></div>
          <ol class="captions">
            {story.scenes.map((sc) => (
              <li data-caption><button type="button"><span class="cap-n">{sc.n}</span><span class="cap-t"><strong>{sc.title}</strong><span>{sc.body}</span></span></button></li>
            ))}
          </ol>
          <div class="story-foot">
            <button type="button" class="story-play" data-story-play data-play-label={demo.play} aria-pressed="true">
              <svg class="i-pause" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
              <svg class="i-play" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.9l10-6.5a1 1 0 0 0 0-1.8l-10-6.5A1 1 0 0 0 8 5.5Z"></path></svg>
              <span data-story-play-label>{demo.pause}</span>
            </button>
            <div class="story-bar" aria-hidden="true"><span></span></div>
          </div>
        </div>
      </div>
      <!-- The real thing: a reviewed recording, made up apart from Didja's own names -->
      <div class="wrap pad-bottom-104 real stack-32">
        <div class="intro center" data-reveal>
          <p class="eyebrow">{real.eyebrow}</p>
          <h3 class="h3" data-light>{real.title}</h3>
          <p class="lead">{real.lead}</p>
        </div>
        <figure class="real-video" data-reveal>
          <video src="/media/didja-demo.mp4" poster="/media/didja-demo-poster.jpg" width="1352" height="878"
            muted loop playsinline controls preload="none" aria-label={real.label} data-autoplay></video>
        </figure>
      </div>
      <!-- Measured (SCR-111): the benchmark's headline, from bench.json, never typed by hand -->
      <div class="wrap pad-bottom-104 stack-32">
        <div class="intro center" data-reveal>
          <p class="eyebrow">{measured.eyebrow}</p>
          <h3 class="h3" data-light>{measured.title}</h3>
          <p class="lead">{measured.lead}</p>
          <p class="lead">{measured.limit} <a href={`${GITHUB}/blob/main/engine/bench/README.md`}>{measured.method}</a></p>
        </div>
      </div>
    </section>

    <!-- PRIVACY -->
    <section id="privacy" aria-labelledby="privacy-h" class="dark">
      <div class="wrap pad-112 privacy">
        <div class="privacy-copy">
          <p class="eyebrow on-dark">{privacy.eyebrow}</p>
          <h2 id="privacy-h" class="h2">{privacy.title}</h2>
          <p class="lead on-dark">{privacy.lead}</p>
          <a href={GITHUB} class="btn btn-ghost">{privacy.readCode}</a>
        </div>
        <ul class="promises">
          {privacy.promises.map((p) => (
            <li>
              <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFD93D" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10"></path></svg>
              <strong>{p.title}</strong>
              <span>{p.body}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section aria-labelledby="faq-h" class="faq">
      <h2 id="faq-h" class="h2 faq-h" data-light>{faq.title}</h2>
      {faq.items.map((q) => (
        <details>
          <summary>{q.q}</summary>
          <p>{q.a}</p>
        </details>
      ))}
    </section>

    <!-- DOWNLOAD -->
    <section id="download" aria-labelledby="dl-h" class="wrap pad-bottom-104">
      <div class="cta">
        <h2 id="dl-h">{cta.title}</h2>
        <p class="cta-lead">{cta.lead}</p>
        <div class="row center">
          <a href={DOWNLOAD} class="btn btn-dark btn-big">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={downloadIcon}></svg>
            {cta.download}
          </a>
          <a href={GITHUB} class="btn btn-line btn-big">{cta.source}</a>
        </div>
        <p class="cta-fine">{cta.fine.replace('{version}', version)} <a href={RELEASES}>{cta.notes}</a></p>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-row">
      <span><strong class="foot-name">{footer.name}</strong> · {footer.domain} · {footer.license}</span>
      <span class="foot-links">
        <a href={GITHUB}>{footer.github}</a>
        <a href="#privacy">{footer.privacy}</a>
        <a href="/compare">{footer.compare}</a>
        <a href={RELEASES}>{footer.changelog}</a>
        <a href={`mailto:${footer.email}`}>{footer.email}</a>
      </span>
    </div>
  </footer>

  <script is:inline src={`/scripts/site.js?v=${scriptVersion}`} defer></script>
</body>
</html>

<style>
  /* Nav */
  .top { border-bottom: 1px solid var(--line); }
  .nav { padding-top: 18px; padding-bottom: 18px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; min-height: 44px; }
  .word { font-family: var(--display); font-weight: 800; font-size: 24px; letter-spacing: -0.02em; }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .links a { padding: 10px 14px; min-height: 44px; display: flex; align-items: center; text-decoration: none; font-weight: 500; }
  .links .pill-dark { padding: 10px 18px; border-radius: 999px; background: var(--ink); color: var(--paper); font-weight: 600; }
  .links .pill-dark:hover { background: #2B2B29; color: var(--paper); }

  /* Hero */
  .hero { padding-top: 88px; padding-bottom: 72px; display: flex; flex-wrap: wrap; align-items: center; gap: 56px; }
  .hero-copy { flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .tag { margin: 0; align-self: flex-start; padding: 6px 14px; border-radius: 999px; background: var(--highlighter); color: var(--ink); font-size: 14px; font-weight: 600; }
  h1 { margin: 0; font-family: var(--display); font-weight: 800; font-size: clamp(40px, 6vw, 68px); line-height: 1.02; letter-spacing: -0.035em; }
  .marker:not(.swipe) { background: var(--highlighter); }
  .marker { padding: 0 10px; border-radius: 10px; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .hero-sub { margin: 0; font-size: 20px; line-height: 1.5; color: var(--graphite); max-width: 40ch; }
  .hero-bold { margin: 0; font-size: 20px; line-height: 1.45; font-weight: 600; color: var(--ink); max-width: 40ch; }
  .row { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 8px; }
  .row.center { justify-content: center; padding-top: 0; }
  .fine { margin: 0; font-size: 14px; color: var(--muted-2); }

  .hero-mock { flex: 1 1 440px; min-width: 0; display: flex; justify-content: center; }
  .hero-mock { position: relative; container-type: inline-size; }
  .stroke { position: absolute; inset: -60px -40px; width: calc(100% + 80px); height: calc(100% + 120px); z-index: 0; overflow: visible; pointer-events: none; }
  .stroke path { fill: none; stroke: var(--highlighter); stroke-width: 26; stroke-linecap: round; stroke-linejoin: round; opacity: .9; }
  /* The hero: a Mac's top-right corner. Its height never changes as it plays (the ask's space is kept), so the text beside it stays put. */
  .mock { position: relative; z-index: 1; width: 100%; max-width: 520px; border-radius: 20px; overflow: hidden; padding-bottom: 22px;
    background: radial-gradient(120% 90% at 85% 0%, #f6e7cd 0%, #e9cfa6 45%, #cf9f6c 100%);
    box-shadow: 0 0 0 1px rgba(20,20,20,.1), 0 40px 70px -30px rgba(20,20,20,.45);
    font-family: -apple-system, BlinkMacSystemFont, var(--body); }
  .menubar { position: relative; z-index: 3; display: flex; align-items: center; gap: 14px; height: 30px; padding: 0 12px; font-size: 13px; color: var(--ink);
    background: rgba(250,246,240,.62); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
  .mb-apple { flex: none; }
  .mb-app { font-weight: 700; }
  .mb-menu { color: rgba(20,20,20,.85); }
  .mb-right { margin-left: auto; display: flex; align-items: center; gap: 12px; white-space: nowrap; }
  .menubar-item { display: flex; align-items: center; gap: 5px; height: 22px; padding: 0 7px; border-radius: 6px; background: rgba(20,20,20,.14); font-weight: 600; font-variant-numeric: tabular-nums; }

  .term { position: absolute; z-index: 1; left: 18px; top: 92px; width: 300px; border-radius: 10px; overflow: hidden; background: #1E1F22; color: #D8D8D0;
    box-shadow: 0 20px 40px -18px rgba(20,20,20,.55); font: 12px/1.7 var(--mono); padding-bottom: 8px; opacity: .92; }
  .term-bar { display: flex; align-items: center; gap: 6px; height: 26px; padding: 0 10px; background: #2B2C30; color: #9A9A92; font-size: 11px; }
  .term-bar i { width: 9px; height: 9px; border-radius: 999px; background: #55565B; }
  .term-bar span { margin: 0 auto; padding-right: 30px; }
  .term-line { padding: 0 12px; white-space: nowrap; overflow: hidden; }
  .term-line:nth-of-type(3) { color: #7DD3A0; }

  .panel { position: relative; z-index: 2; margin: 10px 14px 0 auto; width: min(392px, calc(100% - 28px)); background: rgba(250,250,247,.97); border-radius: 14px;
    border: 1px solid rgba(20,20,20,.12); padding: 10px 10px 8px; display: flex; flex-direction: column; box-shadow: 0 26px 60px -22px rgba(20,20,20,.55); }
  /* The arrow up to Didja's icon in the menu bar. */
  .panel::before { content: ''; position: absolute; top: -7px; right: 104px; width: 14px; height: 14px; background: rgba(250,250,247,.97);
    border-left: 1px solid rgba(20,20,20,.12); border-top: 1px solid rgba(20,20,20,.12); transform: rotate(45deg); border-radius: 3px 0 0 0; }
  .panel-head { display: flex; justify-content: space-between; align-items: center; padding: 2px 4px 8px; gap: 8px; }
  .panel-brand { display: flex; align-items: center; gap: 7px; }
  .panel-title { font-family: var(--display); font-weight: 700; font-size: 16px; }
  .panel-pill { padding: 1px 8px; border-radius: 999px; background: #FFE98A; font-size: 11.5px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .panel-tools { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--graphite); }
  .tool-plus { font-size: 17px; line-height: 1; color: var(--pencil); }
