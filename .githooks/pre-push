#!/bin/sh
# Didja: check every commit being pushed, its changes and its message, and run gitleaks on them.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # deleting a branch
  if [ "$remote_sha" = "$zero" ]; then
    # A new tag or branch: check only commits main on GitHub does not have yet. Those it has were
    # checked when they were pushed; checking all history again would block every new tag as soon
    # as a word in an old commit starts to match a new contact.
    remote_sha="$(git merge-base "$local_sha" refs/remotes/origin/main 2>/dev/null || echo "$zero")"
  fi
  /usr/bin/python3 -I "$root/scripts/privacy_check.py" range "$remote_sha" "$local_sha" || exit 1
done
exit 0
