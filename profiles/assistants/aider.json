{
  "$schema": "../schema/assistant.schema.json",
  "id": "aider",
  "name": "Aider",
  "kind": "terminal",
  "about": "Aider. Its banner is \"Aider v…\", it reports \"Tokens: … sent\", and it asks \"Run shell command? (Y)es/(N)o\" before running one; a command you decline is yours to run.",
  "match": {
    "terminal": {
      "titles": [
        "(?i)^aider\\b"
      ],
      "signatures": [
        "^Aider v\\d",
        "Tokens: .* sent",
        "Run shell command\\? \\(Y\\)es/\\(N\\)o"
      ]
    }
  },
  "turns": {
    "userPrompt": [
      "^\\s*(?:aider|architect|ask|code)?> "
    ]
  },
  "agentWork": {
    "approval": [
      "Run shell command\\? \\(Y\\)es/\\(N\\)o",
      "Add command output to the chat\\?"
    ],
    "ran": [
      "^\\s*Running "
    ]
  },
  "status": "builtIn"
}
