{
  "$schema": "../schema/assistant.schema.json",
  "id": "vscode-copilot",
  "name": "Copilot in VS Code",
  "kind": "editor",
  "about": "GitHub Copilot's chat and agent panel in VS Code. It asks \"Run zsh command?\" with Allow and Skip, says \"Ran `…`\" after, and keeps its own todo list (\"Todos (2/4)\").",
  "match": {
    "editor": {
      "signatures": [
        "^\\s*Run (?:zsh|bash|pwsh|sh) command\\?"
      ],
      "together": [
        [
          "^⟦Chat⟧$",
          "^\\s*GitHub Copilot\\s*$"
        ]
      ]
    }
  },
  "agentWork": {
    "approval": [
      "^\\s*Run (?:zsh|bash|pwsh|sh) command\\?",
      "^\\s*(?:Allow|Skip)\\s*$"
    ],
    "ran": [
      "^\\s*Ran `"
    ],
    "todo": [
      "^\\s*Todos \\(\\d+/\\d+\\)",
      "^\\s*[✓○]\\s"
    ]
  },
  "status": "builtIn"
}
