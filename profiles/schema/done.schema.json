{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Didja done catalogue",
  "description": "Where common steps are done and what done looks like there (SCR-86). See profiles/README.md.",
  "type": "object",
  "required": [
    "id",
    "name",
    "hosts",
    "places"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kinds"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kinds": {
            "type": "array",
            "items": {
              "enum": [
                "env",
                "url",
                "domain",
                "visibility",
                "dns",
                "provider",
                "deployment"
              ]
            },
            "minItems": 1
          },
          "path": {
            "type": "string",
            "maxLength": 300
          },
          "page": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "after": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "before": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "confirm": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "saved": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "form": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "environments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "followUp": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
