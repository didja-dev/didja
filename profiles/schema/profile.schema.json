{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://didja.dev/schema/profile.json",
  "title": "Didja app profile",
  "description": "How Didja reads one chat or email app. See profiles/README.md. The app checks more than this schema says (patterns, which fields each rule needs).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "kind",
    "match",
    "rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,40}$"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "chat",
        "email"
      ]
    },
    "status": {
      "enum": [
        "builtIn",
        "community",
        "communityNew"
      ]
    },
    "about": {
      "type": "string"
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundleIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "urlPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "linkTargets": {
      "enum": [
        "emailBody",
        "webArea"
      ]
    },
    "stripBidiMarks": {
      "type": "boolean"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "stringTest": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "equals": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            },
            "contains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "matcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^AX"
          }
        },
        "identifier": {
          "$ref": "#/$defs/stringTest"
        },
        "dom": {
          "$ref": "#/$defs/stringTest"
        },
        "class": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "classPrefix": {
          "type": "string"
        }
      }
    },
    "pattern": {
      "type": "string",
      "maxLength": 300
    },
    "step": {
      "oneOf": [
        {
          "enum": [
            "title",
            "description",
            "value",
            "help",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "of": {
              "$ref": "#/$defs/matcher"
            },
            "all": {
              "type": "boolean"
            },
            "join": {
              "type": "string"
            },
            "attr": {
              "oneOf": [
                {
                  "enum": [
                    "title",
                    "description",
                    "value",
                    "help",
                    "text"
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "enum": [
                      "title",
                      "description",
                      "value",
                      "help",
                      "text"
                    ]
                  }
                }
              ]
            },
            "squash": {
              "type": "boolean"
            },
            "dropLabel": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "pattern": {
              "$ref": "#/$defs/pattern"
            },
            "trim": {
              "type": "string"
            },
            "reject": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "contains": {
              "type": "string"
            }
          }
        }
      ]
    },
    "source": {
      "oneOf": [
        {
          "$ref": "#/$defs/step"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1
        }
      ]
    },
    "parseStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "pattern"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "pattern": {
          "$ref": "#/$defs/pattern"
        },
        "set": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "unless": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is",
        "where"
      ],
      "properties": {
        "is": {
          "enum": [
            "chatName",
            "message",
            "messageList",
            "reactionList",
            "skip",
            "line",
            "emailHeader",
            "emailSubject",
            "emailSection",
            "emailMessage",
            "emailBody"
          ]
        },
        "where": {
          "$ref": "#/$defs/matcher"
        },
        "idAfter": {
          "type": "string"
        },
        "unless": {
          "$ref": "#/$defs/matcher"
        },
        "chat": {
          "$ref": "#/$defs/source"
        },
        "groupIf": {
          "$ref": "#/$defs/matcher"
        },
        "from": {
          "$ref": "#/$defs/source"
        },
        "time": {
          "$ref": "#/$defs/source"
        },
        "body": {
          "$ref": "#/$defs/matcher"
        },
        "mentionsMe": {
          "$ref": "#/$defs/source"
        },
        "myReaction": {
          "$ref": "#/$defs/source"
        },
        "item": {
          "$ref": "#/$defs/matcher"
        },
        "label": {
          "$ref": "#/$defs/source"
        },
        "parse": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parseStep"
          }
        },
        "plainKinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pattern"
          }
        },
        "rowChat": {
          "$ref": "#/$defs/source"
        },
        "rowLabel": {
          "$ref": "#/$defs/source"
        },
        "text": {
          "$ref": "#/$defs/source"
        },
        "line": {
          "type": "string"
        }
      }
    }
  }
}
