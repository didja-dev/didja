<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- EventKit under the hardened runtime: Apple Reminders (SCR-121) and calendar-aware snooze (SCR-117).
	     Both are off until the user turns them on and macOS asks. Nothing else: never get-task-allow. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
