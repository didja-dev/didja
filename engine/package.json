{
  "name": "didja-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reads screen observations from SQLite, extracts tasks, matches completions",
  "bin": {
    "didja": "src/cli.ts"
  },
  "scripts": {
    "cli": "bun src/cli.ts",
    "start": "bun src/cli.ts run",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile src/cli.ts --outfile dist/didja"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
