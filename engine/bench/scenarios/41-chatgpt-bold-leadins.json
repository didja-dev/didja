  "about": "ChatGPT desktop: numbered steps with bold lead-ins and the command after a dash; you run both in Terminal.",
  "start": "2026-11-12T10:00",
  "steps": [
    {
      "at": 0,
      "app": "ChatGPT",
      "bundle": "com.openai.chat",
      "title": "Stripe webhooks locally",
      "text": [
        "⟦Message 2⟧",
        "ChatGPT said:",
        "To test webhooks locally:",
        "1. Install the CLI — Download it from stripe.com/docs/stripe-cli or use Homebrew.",
        "2. Log in — run `stripe login` and confirm in the browser.",
        "3. Forward events — run `stripe listen --forward-to localhost:3000/api/webhooks`",
        "You'll get a signing secret starting with whsec_ to put in .env.local."
      ]
    },
    {
      "at": 4,
      "app": "Terminal",
      "bundle": "com.apple.Terminal",
      "title": "zsh",
      "text": [
        "mike@mac acme-web % stripe login",
