        "> Done! The Stripe CLI is configured for Acme with account id acct_000",
        "mike@mac acme-web % "
      ]
    },
    {
      "at": 6,
      "app": "Terminal",
      "bundle": "com.apple.Terminal",
      "title": "zsh",
      "text": [
        "mike@mac acme-web % stripe listen --forward-to localhost:3000/api/webhooks",
