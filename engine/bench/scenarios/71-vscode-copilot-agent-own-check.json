{
  "id": "vscode-copilot-agent-own-check",
  "family": "vscode-copilot",
  "about": "Copilot agent ticks its own step (\"✓ Added the redirect URI to config\"); your step in Google Cloud is not done, and the console is open without it.",
  "start": "2026-11-12T10:00",
  "steps": [
    {
      "at": 0,
      "app": "Code",
      "bundle": "com.microsoft.VSCode",
      "title": "acme-web",
      "text": [
        "⟦Chat⟧",
        "GitHub Copilot",
        "✓ Added the redirect URI to src/config.ts",
        "One step is on you:",
        "1. Add https://acme.example.com/oauth/callback to Authorized redirect URIs in Google Cloud",
        "2. Then restart the dev server"
      ]
    },
    {
      "at": 5,
      "app": "Google Chrome",
      "bundle": "com.google.Chrome",
      "title": "Edit OAuth client – Google Cloud console",
      "url": "https://console.cloud.google.com/apis/credentials/oauthclient/000-acme",
      "text": [
        "Client ID for Web application",
        "Authorized redirect URIs",
        "URIs 1",
        "http://localhost:3000/oauth/callback",
        "+ Add URI"
      ]
    }
  ],
  "expect": {
    "tasks": [
      {
        "words": [
          "redirect uris"
        ],
        "done": null
      },
      {
        "words": [
          "restart"
        ],
        "done": null
      }
    ],
    "none": []
  }
}
